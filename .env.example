# Copy to .env. Set these two values for real extraction. Never commit .env.
OPENAI_API_KEY=
INVOICE_MODEL=
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
DATABASE_URL=postgresql+psycopg://ap:ap_local_only@localhost:5434/apdesk
REDIS_URL=redis://localhost:6381/0
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=apdesk_local
S3_SECRET_KEY=apdesk_local_storage_only
S3_BUCKET=apdesk
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
API_INTERNAL_URL=http://localhost:8005
MAX_UPLOAD_MB=10
MAX_PAGES=10
MAX_SESSION_UPLOADS=40
MAX_GLOBAL_UPLOADS_DAILY=300
MAX_GLOBAL_MODEL_CALLS_DAILY=100
MAX_SESSION_MODEL_CALLS_DAILY=30
SESSION_HOURS=24
